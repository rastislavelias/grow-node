generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ControllerType {
  ESP32
  SIMULATOR
}

enum ControllerStatus {
  ONLINE
  OFFLINE
}

enum ZoneStatus {
  NORMAL
  WARNING
  DANGER
}

enum ZonePhase {
  LIGHT_ON
  LIGHT_OFF
}

enum CommandSource {
  MANUAL
  AUTOMATIC
}

enum CommandType {
  SET_OUTPUT
}

enum CommandStatus {
  PENDING
  PUBLISHED
  ACKNOWLEDGED
  FAILED
}

model PlantProfile {
  id String @id @default(cuid())

  name String @unique

  scheduleStartMinutes    Int
  scheduleDurationMinutes Int
  phaseConfig             Json

  zones Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id String @id

  name String

  plantProfileId String
  plantProfile   PlantProfile @relation(fields: [plantProfileId], references: [id], onDelete: Restrict)

  controllerType            ControllerType
  controllerFirmwareVersion String?
  controllerLastSeenAt      DateTime?

  telemetryReadings TelemetryReading[]
  commands          Command[]
  heartbeats        ControllerHeartbeat[]
  state             ZoneState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelemetryReading {
  id String @id @default(cuid())

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  recordedAt DateTime

  temperatureC Float
  humidityPct  Float
  lightLux     Float

  estimatedPpfd       Float?
  vpdKpa              Float?
  condensationMarginC Float?

  rawPayload Json?

  createdAt DateTime @default(now())

  @@index([zoneId, recordedAt])
}

model ZoneState {
  id String @id @default(cuid())

  zoneId String @unique
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  status      ZoneStatus @default(NORMAL)
  activePhase ZonePhase  @default(LIGHT_OFF)

  fanDesired    Boolean @default(false)
  lightDesired  Boolean @default(false)
  heaterDesired Boolean @default(false)

  reasons Json?

  lastTelemetryAt DateTime?
  lastEvaluatedAt DateTime?

  updatedAt DateTime @updatedAt
}

model Command {
  id String @id @default(cuid())

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  source CommandSource
  type   CommandType
  status CommandStatus @default(PENDING)

  payload Json

  createdAt      DateTime  @default(now())
  publishedAt    DateTime?
  acknowledgedAt DateTime?

  @@index([zoneId, createdAt])
  @@index([status])
}

model ControllerHeartbeat {
  id String @id @default(cuid())

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  seenAt          DateTime
  status          ControllerStatus
  firmwareVersion String?

  createdAt DateTime @default(now())

  @@index([zoneId, seenAt])
}
