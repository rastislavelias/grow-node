{
  "name": "grow-node",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @grow-node/db db:generate",
    "db:migrate": "pnpm --filter @grow-node/db db:migrate",
    "db:seed": "pnpm --filter @grow-node/db db:seed",
    "db:studio": "pnpm --filter @grow-node/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "packageManager": "pnpm@11.9.0"
}
